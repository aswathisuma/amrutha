APP_NAME=HayFixr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=dummy_db_user
# DB_PASSWORD=dummy_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=dummy_mail_user
MAIL_PASSWORD=dummy_mail_password
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=dummy_aws_access_key_id
AWS_SECRET_ACCESS_KEY=dummy_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dummy-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC
CRM_DISPLAY_TIMEZONE=Asia/Kolkata
CRM_DEMO_SWITCHER=true

# WhatsApp Cloud API — dummy placeholders. Values starting with "dummy" keep the app in local mode (nothing is sent to Meta).
WHATSAPP_PHONE_ID=dummy_phone_number_id
WHATSAPP_BUSINESS_ID=dummy_business_account_id
WHATSAPP_TOKEN=dummy_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=dummy_verify_token
WHATSAPP_APP_SECRET=dummy_whatsapp_app_secret

# Workflow / finance policy (see config/crm.php)
CRM_GST_RATE=0.18
CRM_ALLOW_PARTIAL_PAYMENTS=true
CRM_CHARGE_APPROVAL_THRESHOLD=0.25

# API tokens (minutes)
SANCTUM_TOKEN_EXPIRATION=480
CRM_DEMO_PASSWORD="DummyDemoPass#2026"
